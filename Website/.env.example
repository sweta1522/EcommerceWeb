PORT=4000
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=postgres
PG_DATABASE=website_db

# Cloud database (optional). When set, it takes priority over the PG_* variables above.
# DATABASE_URL=postgres://user:password@host:5432/dbname
# SSL is on by default when DATABASE_URL is set. Set to false for a local non-SSL database.
# PG_SSL=false
